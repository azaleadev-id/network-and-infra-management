APP_ENV=local
APP_DEBUG=true
APP_NAME="Network & Infrastructure Management"
APP_KEY=your_random_application_key
APP_TIMEZONE=Asia/Jakarta

DB_HOST=localhost
DB_NAME=rt_rw_net
DB_USER=root
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

MIKROTIK_HOST=192.0.2.10
MIKROTIK_USER=your_router_username
MIKROTIK_PASS=your_router_password
MIKROTIK_TRANSPORT=socket
MIKROTIK_PORT=8728
MIKROTIK_TIMEOUT=5
MIKROTIK_ATTEMPTS=1
MIKROTIK_DELAY=0
MIKROTIK_REST_SCHEME=http
MIKROTIK_REST_PORT=80
MIKROTIK_REST_PATH=/rest
MIKROTIK_REST_ALLOW_INSECURE=false
MIKROTIK_INTERFACE=ether1
MIKROTIK_SYNC_ON_USER_CREATE=true

MIKROTIK_BRIDGE_ENABLED=false
MIKROTIK_BRIDGE_TOKEN=your_bridge_token
MOBILE_CLIENT_LOOKUP_TOKEN=your_mobile_lookup_token

MAP_TILE_PROVIDER=maptiler
MAPTILER_API_KEY=your_maptiler_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_WEB_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
GOOGLE_ALLOWED_CLIENT_IDS=your_google_oauth_web_client_id.apps.googleusercontent.com
CRON_TOKEN=your_long_random_cron_token

DASHBOARD_CACHE_TTL=10
MAP_CACHE_TTL=30
MIKROTIK_CACHE_TTL=15
