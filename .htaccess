RewriteEngine On

# Preserve Authorization header for PHP/mobile API token auth on Apache/XAMPP.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Redirect direct view file URLs to clean routes.
RewriteCond %{THE_REQUEST} \s/+(.*/)?views/(dashboard|hotspot|infra|login|payments|pppoe|register|register-mikrotik|settings|superadmin|users)\.php(?:[\s?]|$) [NC]
RewriteRule ^views/(dashboard|hotspot|infra|login|payments|pppoe|register|register-mikrotik|settings|superadmin|users)\.php$ $1 [R=302,L,NE]

# Keep real files and folders accessible.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean routes for view pages.
RewriteRule ^$ index.php [L]
RewriteRule ^(dashboard|hotspot|infra|login|payments|pppoe|register|register-mikrotik|settings|superadmin|users)$ views/$1.php [L,QSA]
